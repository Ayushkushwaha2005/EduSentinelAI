# Copy to .env and fill in. Never commit .env.

# ─── DATABASE ────────────────────────────────────────────────────────────────
#
# prisma/schema.prisma declares `provider = "postgresql"`, so this MUST be a
# postgres:// or postgresql:// URL. A SQLite path like "file:./dev.db" — which
# this file used to suggest, from before the Postgres migration — makes every
# request fail with:
#
#   PrismaClientInitializationError: Error validating datasource `db`:
#   the URL must start with the protocol `postgresql://` or `postgres://`
#
# YOU DO NOT NEED TO INSTALL ANYTHING. `npm run dev` starts a real local
# PostgreSQL for you (official binaries via embedded-postgres — no Docker, no
# service, no account), syncs the schema, and creates a founder account on an
# empty database. The value below is where it listens.
#
# If you would rather use your own database (Neon, a local install, a
# container), just put its URL here — the dev server detects a valid postgres
# URL and will not start the embedded one.
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/edusentinel"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_TRUST_HOST=true
# 32-byte base64 key for encrypting TOTP secrets (same generator as AUTH_SECRET)
MFA_ENC_KEY=""
# Public base URL used in verification/reset emails
APP_URL="http://localhost:3000"
# Optional: transactional email via Resend; without it, mails log to console
# RESEND_API_KEY=
# MAIL_FROM="EduSentinel AI <no-reply@edusentinel.ai>"
# Second-channel alerts for privileged events (role changes, publishes, revocations)
# ALERT_EMAIL=

# --- Phase 3: release signing & scanning ---
# ed25519 private key (base64 PKCS8). Generate:
#   node -e "const{generateKeyPairSync}=require('crypto');const{privateKey,publicKey}=generateKeyPairSync('ed25519');console.log(privateKey.export({type:'pkcs8',format:'der'}).toString('base64'));require('fs').writeFileSync('public/signing-key.pem',publicKey.export({type:'spki',format:'pem'}))"
# The matching public key must be served at /signing-key.pem for users to verify downloads.
SIGNING_PRIVATE_KEY=""
# Optional malware scanning (else artifacts report NO_SCANNER — see SECURITY-NOTES SN-005)
# VIRUSTOTAL_API_KEY=

# Optional: founder bootstrap for `npm run db:seed`
# FOUNDER_EMAIL=
# FOUNDER_NAME=
# FOUNDER_PASSWORD=   (min. 10 characters)

# --- Phase 7 + 10: transactional mail ---
#
# ⚠ REQUIRED IN PRODUCTION. Without RESEND_API_KEY, lib/mail.ts now FAILS and
# records the failure rather than silently writing to storage/outbox and
# reporting success — an invitation that nobody receives while the Founder is
# told it was sent is worse than a visible error (Phase 10, Task 11).
#
# In development it stays optional: mail is written to storage/outbox so the
# whole flow, links included, is testable without sending anything.
#
# Before this works in production:
#   1. Add edusentinel.ai as a sending domain in Resend.
#   2. Publish the SPF and DKIM records it gives you on the domain's DNS.
#   3. Set both variables below in the Vercel project (Production + Preview).
#
# MAIL_FROM must be an address on the VERIFIED sending domain. The Google
# Workspace aliases (hello@, security@, …) RECEIVE mail; sending as them requires
# the domain verification above. Addresses themselves live in src/lib/org-email.ts.
# RESEND_API_KEY="re_..."
# MAIL_FROM="EduSentinel AI <no-reply@edusentinel.ai>"
